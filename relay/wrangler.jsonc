{
  "name": "codex-quota-share-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "LOCAL_DEV": "false"
  },
  "ratelimits": [{ "name": "PAIRING_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_GROUPS",
        "class_name": "QuotaGroup"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QuotaGroup"
      ]
    }
  ]
}
